# Database connection string (SQLite for dev, PostgreSQL for production)
DATABASE_URL="file:./dev.db"

# Session & Authentication Secret (Generate a strong 32+ character random string in production)
SESSION_SECRET="your-secure-session-secret-here"

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Initial Administrator Provisioning Credentials (Used by npm run seed:admin)
ADMIN_EMAIL="admin@yourdomain.com"
ADMIN_PASSWORD="YourStrongPassword123!"
ADMIN_NAME="Head Baker"

# Business Information Defaults
NEXT_PUBLIC_BUSINESS_NAME="Home Bakery"
NEXT_PUBLIC_BUSINESS_PHONE="+92 330 2964562"
NEXT_PUBLIC_BUSINESS_WHATSAPP="923302964562"
NEXT_PUBLIC_BUSINESS_ADDRESS="House R-1932, Block 17, Gulberg Town, Karachi, 75950, Pakistan"
NEXT_PUBLIC_MAPS_URL="https://www.google.com/maps/search/?api=1&query=Home+Bakery+House+R-1932+Block+17+Gulberg+Town+Karachi"

# Google Gemini AI Integration (Server-only, do NOT prefix with NEXT_PUBLIC_)
# Obtain from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-1.5-flash"

# Resend Email Integration (Server-only, do NOT prefix with NEXT_PUBLIC_)
# Obtain from Resend Console: https://resend.com/api-keys
RESEND_API_KEY="your-resend-api-key-here"
HOME_BAKERY_CONTACT_EMAIL="contact@homebakery.pk"
EMAIL_FROM="Home Bakery <onboarding@resend.dev>"
